DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# ModelRouter: existing text route
AGENT_TEXT_PROVIDER=deepseek
AGENT_TEXT_TIMEOUT_SECONDS=30
AGENT_TEXT_MAX_RETRIES=1
AGENT_TEXT_MAX_OUTPUT_TOKENS=800
# Fill current provider pricing to enable cost estimation; 0 means unknown/free.
AGENT_TEXT_INPUT_COST_PER_1M_CNY=0
AGENT_TEXT_OUTPUT_COST_PER_1M_CNY=0

# ModelRouter: cloned deployments stay disabled until a vision key is configured.
AGENT_VISION_PROVIDER=disabled
AGENT_VISION_TIMEOUT_SECONDS=45
AGENT_VISION_MAX_RETRIES=1
AGENT_VISION_MAX_OUTPUT_TOKENS=1200
AGENT_VISION_INPUT_COST_PER_1M_CNY=0
AGENT_VISION_OUTPUT_COST_PER_1M_CNY=0

# Recommended free vision MVP preset:
# AGENT_VISION_PROVIDER=zhipu
# ZHIPU_API_KEY=your-zhipu-key
# AGENT_VISION_MODEL=glm-4.1v-thinking-flash
#
# Alternative Qwen VL preset:
# AGENT_VISION_PROVIDER=qwen
# DASHSCOPE_API_KEY=your-dashscope-key
# AGENT_VISION_MODEL=qwen3-vl-flash
# AGENT_VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#
# Alternative Tencent TokenHub preset:
# AGENT_VISION_PROVIDER=tencent
# TENCENT_TOKENHUB_API_KEY=your-tokenhub-key
# AGENT_VISION_MODEL=hy-vision-2.0-instruct
# AGENT_VISION_BASE_URL=https://tokenhub.tencentmaas.com/v1

# Harness budgets apply to one Agent turn.
AGENT_MAX_MODEL_CALLS=2
AGENT_MAX_MODEL_INPUT_TOKENS=6000
AGENT_MAX_MODEL_OUTPUT_TOKENS=2000
AGENT_MAX_ESTIMATED_COST_CNY=0.25
AGENT_MAX_MODEL_CONCURRENCY=2
AGENT_MODEL_BACKOFF_SECONDS=0.5
AGENT_MODEL_LOG_ENABLED=true
AGENT_MODEL_LOG_PATH=logs/model_calls.jsonl

# Sanitized image evidence is stored outside LangGraph State and expires locally.
AGENT_IMAGE_MAX_BYTES=8388608
AGENT_IMAGE_MAX_PIXELS=20000000
AGENT_IMAGE_MIN_DIMENSION=96
AGENT_IMAGE_RETENTION_HOURS=24

EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_NORMALIZE=true
VECTOR_DB_PROVIDER=chroma
VECTOR_DB_COLLECTION=langchain
VECTOR_DB_DISTANCE_METRIC=l2
CHROMA_DB_DIR=chroma_db
DOCS_DIR=docs
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=80
RAG_MAX_DISTANCE=1.0
RAG_UPLOAD_DIR=data/rag_uploads
RAG_STATE_DB_PATH=data/rag_documents.sqlite3
RAG_ALLOWED_EXTENSIONS=.pdf,.docx,.xlsx,.txt,.md,.png,.jpg,.jpeg,.webp
RAG_DOCUMENT_MAX_BYTES=20971520
RAG_IMAGE_MAX_BYTES=10485760
RAG_BATCH_MAX_BYTES=52428800
RAG_OCR_ENABLED=true
RAG_OCR_BACKEND=rapidocr_onnxruntime
LANGGRAPH_CHECKPOINT_DB=logs/langgraph_checkpoints.sqlite3
HANDOFF_DB_PATH=logs/handoff_cases.sqlite3
AGENT_MEMORY_DB=logs/agent_memory.sqlite3
CONVERSATION_DB_PATH=logs/conversation_threads.sqlite3
AGENT_CONTEXT_MAX_TOKENS=1400
AGENT_CONTEXT_RECENT_MESSAGES=8
AGENT_CONTEXT_MESSAGE_CHARS=600
AGENT_CONTEXT_SUMMARY_CHARS=1000
AGENT_CONTEXT_MEMORY_ITEMS=8
AGENT_CONTEXT_RAG_ITEMS=3
AGENT_CONTEXT_RAG_CHARS=420
AGENT_CONTEXT_TOOL_CHARS=1000
